DATABASE_URL=postgresql://user:password@localhost/ananta_db
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

# Authentification (obligatoire par défaut lorsque ENVIRONMENT=production)
AUTH_REQUIRED=false
# Jeton à usage initial pour créer la première clé admin. Générez-le avec:
#   openssl rand -hex 24
ANANTA_BOOTSTRAP_TOKEN=
CORS_ORIGINS=http://localhost:8010
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Désactivez la validation TLS des cibles uniquement pour un audit explicitement autorisé.
ALLOW_INSECURE_TARGET_TLS=false

LLM_API_URL=http://127.0.0.1:5000/v1/chat/completions
LLM_TIMEOUT=420

# Optional APIs
CENSYS_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
SECURITYTRAILS_API_KEY=
SPIDERFOOT_API_URL=http://127.0.0.1:5001
SPIDERFOOT_API_KEY=

# === Entity Research (recherche de personne physique/morale) ===
# 18 des 23 sources fonctionnent sans aucune clé (Sirene, GLEIF, VIES, BODACC,
# SEC EDGAR, Wikidata, ORCID, RDAP, DNS-over-HTTPS, ...).
# Les clés ci-dessous ne font qu'élargir la couverture.
OPENSANCTIONS_API_KEY=
OPENSANCTIONS_API_URL=          # ou instance yente auto-hébergée
COMPANIES_HOUSE_API_KEY=        # registre britannique
OPENCORPORATES_API_KEY=         # 140+ juridictions
PAPPERS_API_KEY=                # bilans et bénéficiaires effectifs (FR)
HIBP_API_KEY=                   # fuites de données (opt-in explicite)
GITHUB_TOKEN=                   # relève les quotas de l'API GitHub
SEC_EDGAR_CONTACT=              # email de contact exigé par la SEC
ENTITY_RESEARCH_USER_AGENT=     # User-Agent des requêtes sortantes
ENTITY_RESEARCH_HTTP_TIMEOUT=12
